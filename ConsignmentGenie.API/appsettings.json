{
  "ConnectionStrings": {
    "DefaultConnection": "your-database-connection-string-here"
  },
  "Jwt": {
    "Key": "your-jwt-signing-key-here",
    "Issuer": "ConsignmentGenieAPI",
    "Audience": "ConsignmentGenieClient",
    "ExpirationHours": 24
  },
  "Stripe": {
    "SecretKey": "your-stripe-secret-key-here",
    "PublishableKey": "your-stripe-publishable-key-here",
    "WebhookSecret": "your-stripe-webhook-secret-here",
    "SuccessUrl": "http://localhost:4200/billing/success",
    "CancelUrl": "http://localhost:4200/billing/cancel",
    "ProductLookupKeys": {
      "BaseRegular": "base_regular",
      "BaseFounder1": "base_founder1",
      "BaseFounder2": "base_founder2",
      "SquareRegular": "square_regular",
      "SquareFounder": "square_founder",
      "QuickBooksRegular": "quickbooks_regular",
      "QuickBooksFounder": "quickbooks_founder",
      "DwollaRegular": "dwolla_regular",
      "DwollaFounder": "dwolla_founder"
    },
    "Connect": {
      "ClientId": "your-stripe-connect-client-id-here",
      "ClientSecret": "your-stripe-connect-client-secret-here",
      "RedirectUri": "https://yourdomain.com/api/stripe-connect/callback"
    }
  },
  "Resend": {
    "ApiKey": "your-resend-api-key-here",
    "FromEmail": "noreply@microsaasbuilders.com",
    "FromName": "ConsignmentGenie",
    "BccEmail": "stevewash123@gmail.com"
  },
  "PhotoStorage": {
    "Provider": "cloudinary"
  },
  "Cloudinary": {
    "CloudName": "your-cloudinary-cloud-name-here",
    "ApiKey": "your-cloudinary-api-key-here",
    "ApiSecret": "your-cloudinary-api-secret-here"
  },
  "PhotoSettings": {
    "MaxPhotosPerItem": 3,
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"]
  },
  "Azure": {
    "Storage": {
      "ConnectionString": "your-azure-storage-connection-string-here",
      "ContainerName": "consignmentpro-photos"
    }
  },
  "QuickBooks": {
    "ClientId": "your-quickbooks-client-id-here",
    "ClientSecret": "your-quickbooks-client-secret-here",
    "RedirectUri": "http://localhost:4200/quickbooks/callback",
    "Environment": "sandbox"
  },
  "SalesTax": {
    "Provider": "manual",
    "MockTaxRate": 0.07
  },
  "ClientUrl": "https://consignmentgenie-ui.onrender.com",
  "App": {
    "BaseUrl": "https://consignmentgenie-ui.onrender.com"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "https://consignmentgenie-ui.onrender.com"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "CategoryValidation": {
    "ExactMatchThreshold": 1.0,
    "CloseMatchThreshold": 0.70,
    "LevenshteinWeight": 0.40,
    "TokenOverlapWeight": 0.35,
    "ContainsWeight": 0.25
  },
  "AllowedHosts": "*"
}
